#!/usr/bin/env bash
#
# VPS Optimizer - Management CLI
# Mobile LTE/H+, ZIVPN, and High-Speed Streaming Optimized.
#
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(dirname "$SCRIPT_PATH")"

# shellcheck source=/dev/null
[[ -f "$INSTALL_DIR/common.sh" ]] && source "$INSTALL_DIR/common.sh"

SYSCTL_CONF="/etc/sysctl.d/99-vps-optimizer.conf"
LIMITS_CONF="/etc/security/limits.d/99-vps-optimizer.conf"
CONFIG_DIR="/etc/vps-optimizer"
BACKUP_DIR="$CONFIG_DIR/backups"
BADVPN_ENV="$CONFIG_DIR/badvpn.env"
BADVPN_UNIT="/etc/systemd/system/badvpn@.service"
BADVPN_SRC_UNIT="$INSTALL_DIR/badvpn@.service"

if [[ -t 1 ]]; then
    C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_YLW='\033[1;33m'
    C_BLU='\033[0;34m'; C_BLD='\033[1m'; C_NC='\033[0m'
else
    C_RED=''; C_GRN=''; C_YLW=''; C_BLU=''; C_BLD=''; C_NC=''
fi
log()  { printf "${C_BLU}[INFO]${C_NC} %s\n" "$*"; }
ok()   { printf "${C_GRN}[ OK ]${C_NC} %s\n" "$*"; }
warn() { printf "${C_YLW}[WARN]${C_NC} %s\n" "$*"; }
die()  { printf "${C_RED}[FAIL]${C_NC} %s\n" "$*" >&2; exit 1; }

require_root() { [[ $EUID -eq 0 ]] || die "Requires root. Use sudo."; }

generate_sysctl() {
    local mem_mb; mem_mb="$(mem_total_mb)"
    local rmem_max wmem_max tcp_mem

    if   (( mem_mb < 1024 )); then
        rmem_max=67108864; wmem_max=67108864; tcp_mem="196608 262144 393216"
    elif (( mem_mb < 4096 )); then
        rmem_max=134217728; wmem_max=134217728; tcp_mem="393216 524288 786432"
    else
        rmem_max=268435456; wmem_max=268435456; tcp_mem="786432 1048576 1572864"
    fi

    cat > "$SYSCTL_CONF" <<EOF
# =====================================================================
# VPS Optimizer — Mobile/LTE/H+ Streaming & ZIVPN Tuning
# Generated: $(date -Iseconds)
# =====================================================================

# 1. BBR & FQ (Packet loss tolerance & low latency)
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# 2. Massive UDP Buffers (Prevents ZIVPN drops on fluctuating cellular signals)
net.core.rmem_max = ${rmem_max}
net.core.wmem_max = ${wmem_max}
net.core.optmem_max = 65536
net.core.rmem_default = 2097152
net.core.wmem_default = 2097152

# 3. TCP Buffers
net.ipv4.tcp_rmem = 4096 87380 ${rmem_max}
net.ipv4.tcp_wmem = 4096 65536 ${wmem_max}
net.ipv4.tcp_mem = ${tcp_mem}

# 4. CGNAT Keepalive (Prevents mobile carrier from dropping idle connections)
net.ipv4.tcp_keepalive_time = 120
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1

# 5. Mobile MTU Fix (Prevents infinite buffering on LTE/H+)
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_base_mss = 1024

# 6. Streaming Acceleration
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_notsent_lowat = 131072
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_timestamps = 1

# 7. ECN & Limits
net.ipv4.tcp_ecn = 1
net.ipv4.tcp_ecn_fallback = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.ip_local_port_range = 1024 65535
fs.file-max = 1000000
fs.nr_open = 1000000
net.core.somaxconn = 32768
net.core.netdev_max_backlog = 16384
EOF
    ok "Wrote mobile-optimized config to $SYSCTL_CONF"
}

generate_limits() {
    cat > "$LIMITS_CONF" <<'EOF'
# VPS Optimizer — file descriptor limits
*    soft nofile 1000000
*    hard nofile 1000000
root soft nofile 1000000
root hard nofile 1000000
EOF
    ok "Wrote $LIMITS_CONF"
}

backup_existing() {
    mkdir -p "$BACKUP_DIR"
    local ts; ts="$(date +%Y%m%d-%H%M%S)"
    [[ -f "$SYSCTL_CONF" ]] && cp -f "$SYSCTL_CONF" "$BACKUP_DIR/sysctl-$ts.conf"
    [[ -f "$LIMITS_CONF" ]] && cp -f "$LIMITS_CONF" "$BACKUP_DIR/limits-$ts.conf"
}

apply_qdisc() {
    local iface; iface="$(primary_iface)"
    [[ -n "$iface" ]] || return 0
    tc qdisc replace dev "$iface" root fq 2>/dev/null || true
}

cmd_apply() {
    require_root
    log "Applying LTE/H+ and Streaming tuning..."
    backup_existing
    modprobe tcp_bbr 2>/dev/null || true
    generate_sysctl
    generate_limits
    sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || true
    apply_qdisc
    ok "Tuning applied"
    cmd_verify || true
}

cmd_verify() {
    local pass=0 fail=0
    check() {
        local key="$1" exp="$2" cur; cur="$(sysctl -n "$key" 2>/dev/null || echo "N/A")"
        if [[ "$cur" == "$exp" ]]; then pass=$((pass + 1)); else fail=$((fail + 1)); fi
    }
    check net.ipv4.tcp_congestion_control bbr
    check net.core.default_qdisc            fq
    check net.ipv4.tcp_mtu_probing          1
    check net.ipv4.tcp_keepalive_time       120
    
    if (( fail == 0 )); then ok "All $pass mobile checks passed"; else warn "$fail checks failed. Reboot may be required."; fi
}

fmt_mbps() {
    awk -v v="$1" 'BEGIN { if (v >= 1000) printf "%.2f Gbps", v/1000; else printf "%.2f Mbps", v; }'
}

cmd_status() {
    printf "${C_BLD}System Status${C_NC}\n"
    printf "  Kernel:  %s\n" "$(uname -r)"
    printf "  CC:      %s\n" "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')"
    
    local iface; iface="$(primary_iface)"
    if [[ -n "$iface" ]]; then
        printf "${C_BLD}Live Throughput (1s sample) on %s${C_NC}\n" "$iface"
        local rx1 tx1 rx2 tx2
        rx1=$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null || echo 0)
        tx1=$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null || echo 0)
        sleep 1
        rx2=$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null || echo 0)
        tx2=$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null || echo 0)
        local rx_mbps tx_mbps
        rx_mbps=$(awk -v a="$rx1" -v b="$rx2" 'BEGIN { printf "%.2f", (b-a)*8/1000000 }')
        tx_mbps=$(awk -v a="$tx1" -v b="$tx2" 'BEGIN { printf "%.2f", (b-a)*8/1000000 }')
        printf "  RX: %s\n" "$(fmt_mbps "$rx_mbps")"
        printf "  TX: %s\n" "$(fmt_mbps "$tx_mbps")"
    fi
}

cmd_speedtest() {
    echo "Running download bandwidth test (result in Mbps)..."
    local url="https://speed.cloudflare.com/__down?bytes=50000000"
    local tmp; tmp=$(mktemp); trap 'rm -f "$tmp"' RETURN
    curl -o /dev/null -s --max-time 10 "$url" >/dev/null 2>&1 || true # warmup
    local start end dur bytes mbps
    start=$(date +%s.%N)
    curl -o "$tmp" -s --max-time 90 "$url"
    end=$(date +%s.%N)
    bytes=$(stat -c%s "$tmp" 2>/dev/null || echo 0)
    dur=$(awk -v s="$start" -v e="$end" 'BEGIN { printf "%.3f", e - s }')
    (( bytes > 0 )) || die "Download failed."
    mbps=$(awk -v b="$bytes" -v d="$dur" 'BEGIN { printf "%.2f", (b*8)/(d*1000000) }')
    printf "  Speed: %s%s%s\n" "$C_BLD" "$(fmt_mbps "$mbps")" "$C_NC"
}

cmd_badvpn() {
    require_root
    local action="${1:-status}"
    case "$action" in
        install)
            [[ -f "$BADVPN_ENV" ]] || cp "$INSTALL_DIR/badvpn.env" "$BADVPN_ENV"
            if ! command -v badvpn-udpgw >/dev/null 2>&1; then
                log "Building BadVPN..."
                local tmp; tmp=$(mktemp -d)
                (cd "$tmp"; curl -fsSL -o badvpn.tar.gz https://github.com/ambrop72/badvpn/archive/refs/tags/1.999.130.tar.gz; tar xzf badvpn.tar.gz; cd badvpn-1.999.130; cmake -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_TUN2SOCKS=1 . >/dev/null; make -j"$(nproc)" >/dev/null; make install >/dev/null)
                rm -rf "$tmp"
                ok "BadVPN installed"
            fi
            [[ -f "$BADVPN_UNIT" ]] || { cp "$BADVPN_SRC_UNIT" "$BADVPN_UNIT"; systemctl daemon-reload; }
            ;;
        start|stop|restart|status|enable|disable)
            for p in 7100 7200 7300; do systemctl "$action" "badvpn@$p" 2>/dev/null || true; done
            ;;
        *) echo "Usage: op-optimizer badvpn {install|start|stop|restart|status}" ;;
    esac
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    apply)     cmd_apply "$@" ;;
    verify)    cmd_verify "$@" ;;
    status)    cmd_status "$@" ;;
    speedtest) cmd_speedtest "$@" ;;
    badvpn)    cmd_badvpn "$@" ;;
    *) echo "Usage: op-optimizer {apply|verify|status|speedtest|badvpn}" ;;
esac
