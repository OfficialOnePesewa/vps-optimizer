# Auto-detect text files and normalize to LF on commit and checkout
* text=auto eol=lf

# Explicitly force Unix (LF) line endings for all script and config files
*.sh      text eol=lf
*.service text eol=lf
*.env     text eol=lf
*.conf    text eol=lf
*.md      text eol=lf

# Prevent Git from trying to diff binary files
*.tar.gz  binary
*.zip     binary
